<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store distribution entitlements. Hand-rolled codesign requires
         explicit application-identifier and team-identifier to match the
         embedded provisioning profile (prevents ITMS-90886). -->
    <key>com.apple.application-identifier</key>
    <string>V433H655PN.com.pibulus.talktype</string>
    <key>com.apple.developer.team-identifier</key>
    <string>V433H655PN</string>

    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
